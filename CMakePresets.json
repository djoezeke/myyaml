{
  "version": 4,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 10,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "default : Build Library",
      "description": "Main Mode: Build",
      "binaryDir": "${sourceDir}/build",
      "installDir": "${sourceDir}/build/install",
      "cacheVariables": {
        "CMAKE_C_EXTENSIONS": "OFF",
        "CMAKE_CXX_EXTENSIONS": "OFF",
        "MYYAML_BUILD_DOCS": "OFF",
        "MYYAML_BUILD_TESTS": "OFF",
        "MYYAML_BUILD_EXAMPLES": "OFF"
      }
    },
    {
      "name": "develop",
      "displayName": "develop : Build Examples & Test",
      "description": "Development Mode : Build & Test",
      "binaryDir": "${sourceDir}/build",
      "installDir": "${sourceDir}/build/install",
      "generator": "MinGW Makefiles",
      "cacheVariables": {
        "CMAKE_C_EXTENSIONS": "OFF",
        "CMAKE_CXX_EXTENSIONS": "OFF",
        "MYYAML_BUILD_DOCS": "OFF",
        "MYYAML_BUILD_TESTS": "OFF",
        "MYYAML_BUILD_EXAMPLES": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "main",
      "configurePreset": "default",
      "description": "Build library (Release)",
      "configuration": "Release"
    },
    {
      "name": "dev",
      "configurePreset": "develop",
      "description": "Build library (Debug)",
      "configuration": "Debug"
    }
  ],
  "testPresets": [
    {
      "name": "ctest",
      "configurePreset": "develop",
      "execution": { "stopOnFailure": true }
    }
  ]
}
